{
  "name": "alainportfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng run alainportfolio:prerender && rm -rf docs && mkdir docs && cp -r dist/alainportfolio/browser/. docs/ && cp docs/index.html docs/404.html",
    "dev:ssr": "ng run alainportfolio:serve-ssr",
    "serve:ssr": "node dist/alainportfolio/server/main.js",
    "build:ssr": "ng build && ng run alainportfolio:server",
    "prerender": "ng run alainportfolio:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/platform-server": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@angular/ssr": "^21.2.13",
    "@emailjs/browser": "^3.11.0",
    "@ionic/angular": "^8.7.17",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@pdftron/webviewer": "^10.4.0",
    "bootstrap": "^5.3.2",
    "express": "^5.1.0",
    "flag-icons": "^6.11.1",
    "rxjs": "~7.8.0",
