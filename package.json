    "@angular/compiler-cli": "^21.1.3",
    "@angular/localize": "^21.1.3",
    "@ionic/angular-toolkit": "latest",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "brotli-webpack-plugin": "^1.1.0",
    "browser-sync": "^3.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "typescript": "~5.9.3"
